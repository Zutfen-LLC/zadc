{
  "$defs": {
    "AcceptedRisk": {
      "additionalProperties": false,
      "description": "One finding a human decision-maker has explicitly accepted as risk.\n\n``expires_at``, when present, must be later than the enclosing\n:class:`DecisionRecord`'s ``decided_at`` — a comparison against a\nsibling artifact-level field enforced by ``DecisionRecord`` itself\n(not by this model in isolation), and one with no standard JSON Schema\nvocabulary; it is documented as a runtime-only invariant (see\n``docs/api-a2b1-review-decision-artifacts.md``).",
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "not": {
                "pattern": "^.*-00:00$"
              },
              "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "finding_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._\\-]*[A-Za-z0-9])?$",
          "title": "Finding Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "scope": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "rationale",
        "scope"
      ],
      "title": "AcceptedRisk",
      "type": "object"
    },
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "A reference to another canonical ZADC artifact by ID and content digest.\n\nDistinct from :class:`EvidenceReference`, which points at an external,\nnon-ZADC evidence payload rather than another sealed ZADC artifact.",
      "properties": {
        "artifact_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_digest"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "DecisionSubject": {
      "additionalProperties": false,
      "description": "The exact subject a :class:`DecisionRecord` claims to decide about.\n\n``decision_subject_sha`` and ``current_pr_head_sha_observed`` are not\nrequired to match at model construction — freshness and live-head\nreconciliation between the decided-upon subject and the repository's\ncurrent state are deferred to a later validation slice. This model\ndoes not query GitHub or verify either SHA against a live source.",
      "properties": {
        "certification_manifest_ids": {
          "items": {
            "allOf": [
              {
                "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
              },
              {
                "if": {
                  "pattern": "^urn:[uU][uU][iI][dD]:"
                },
                "then": {
                  "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            ],
            "minLength": 1,
            "type": "string"
          },
          "title": "Certification Manifest Ids",
          "type": "array"
        },
        "current_pr_head_sha_observed": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Current Pr Head Sha Observed",
          "type": "string"
        },
        "decision_subject_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Decision Subject Sha",
          "type": "string"
        },
        "pull_request": {
          "exclusiveMinimum": 0,
          "title": "Pull Request",
          "type": "integer"
        },
        "repository_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        },
        "review_report_ids": {
          "items": {
            "allOf": [
              {
                "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
              },
              {
                "if": {
                  "pattern": "^urn:[uU][uU][iI][dD]:"
                },
                "then": {
                  "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            ],
            "minLength": 1,
            "type": "string"
          },
          "title": "Review Report Ids",
          "type": "array"
        }
      },
      "required": [
        "repository_id",
        "pull_request",
        "decision_subject_sha",
        "current_pr_head_sha_observed",
        "review_report_ids",
        "certification_manifest_ids"
      ],
      "title": "DecisionSubject",
      "type": "object"
    },
    "HumanDecisionIdentity": {
      "additionalProperties": false,
      "description": "The claimed human identity that authored a :class:`DecisionRecord`.\n\n``actor_type`` is fixed to ``human`` — a decision record can never be\nproduced by an agent, CI, validator, or service actor. This model\nrecords the claimed identity only; authenticating it against a trusted\nidentity provider is deferred to a later validation slice.",
      "properties": {
        "actor_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "const": "human",
          "title": "Actor Type",
          "type": "string"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "HumanDecisionIdentity",
      "type": "object"
    },
    "PolicyReference": {
      "additionalProperties": false,
      "description": "Reference to the policy governing an artifact.\n\nFields (architecture section 10, ``policy``):\n- ``policy_id``: the policy identifier (e.g. ``zutfen:zadc-policy:standard@0.1.0``).\n- ``policy_source_sha``: the trusted commit SHA the policy was loaded from.\n- ``policy_digest``: the SHA-256 digest of the policy content.",
      "properties": {
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Policy Source Sha",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_source_sha",
        "policy_digest"
      ],
      "title": "PolicyReference",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Identity of the actor that produced an artifact.\n\nFields (architecture section 10, ``producer``):\n- ``actor_type``: human, agent, ci, validator, service.\n- ``actor_id``: URI-shaped global identifier for the actor.\n- ``run_id``: optional run/execution identifier.\n- ``model``: optional model identifier (for agent producers).\n- ``provider``: optional provider/service identifier.",
      "properties": {
        "actor_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "human",
            "agent",
            "ci",
            "validator",
            "service"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "run_id": {
          "anyOf": [
            {
              "allOf": [
                {
                  "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
                },
                {
                  "if": {
                    "pattern": "^urn:[uU][uU][iI][dD]:"
                  },
                  "then": {
                    "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              ],
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Provenance chain for an artifact.\n\nFields (architecture section 10, ``provenance``):\n- ``parent_artifact_ids``: REQUIRED immutable tuple of parent artifact IDs.\n  Accepted as ``list`` or ``tuple`` at construction; internally immutable.\n  Root artifacts must explicitly supply an empty array/tuple.\n- ``content_digest``: optional SHA-256 digest of the artifact content.\n  May be absent only before sealing.",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "parent_artifact_ids": {
          "items": {
            "allOf": [
              {
                "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
              },
              {
                "if": {
                  "pattern": "^urn:[uU][uU][iI][dD]:"
                },
                "then": {
                  "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            ],
            "minLength": 1,
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "parent_artifact_ids"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://schemas.zutfen.com/zadc/0.1/decision-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "accept_risk"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "accepted_risks": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "decision": {
              "const": "accept_risk"
            }
          },
          "required": [
            "decision"
          ]
        }
      },
      "then": {
        "properties": {
          "accepted_risks": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "supersede"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "supersedes_decision_ref": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "supersedes_decision_ref"
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "decision": {
              "const": "supersede"
            }
          },
          "required": [
            "decision"
          ]
        }
      },
      "then": {
        "properties": {
          "supersedes_decision_ref": {
            "type": "null"
          }
        }
      }
    }
  ],
  "description": "An authenticated human decision claim for the Zutfen Agentic Development Contract v0.1 (architecture section A2B1). A structurally valid record does not, by itself, authenticate its human identity or confer merge authorization.",
  "properties": {
    "accepted_risks": {
      "items": {
        "$ref": "#/$defs/AcceptedRisk"
      },
      "title": "Accepted Risks",
      "type": "array"
    },
    "artifact_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "decision_record",
      "title": "Artifact Type",
      "type": "string"
    },
    "conditions": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Conditions",
      "type": "array"
    },
    "contract_version": {
      "const": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "not": {
        "pattern": "^.*-00:00$"
      },
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "not": {
        "pattern": "^.*-00:00$"
      },
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Decided At",
      "type": "string"
    },
    "decided_by": {
      "$ref": "#/$defs/HumanDecisionIdentity"
    },
    "decision": {
      "enum": [
        "request_changes",
        "approve_for_merge",
        "reject",
        "accept_risk",
        "supersede"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/PolicyReference"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "project_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "rationale": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "schema": {
      "const": "https://schemas.zutfen.com/zadc/0.1/artifact.schema.json",
      "title": "Schema",
      "type": "string"
    },
    "slice_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Id",
      "type": "string"
    },
    "slice_instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Instance Id",
      "type": "string"
    },
    "subject": {
      "$ref": "#/$defs/DecisionSubject"
    },
    "supersedes_decision_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema",
    "contract_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "project_id",
    "slice_id",
    "slice_instance_id",
    "policy",
    "provenance",
    "decision_id",
    "decided_by",
    "decided_at",
    "subject",
    "decision",
    "accepted_risks",
    "conditions",
    "rationale"
  ],
  "title": "ZADC Decision Record",
  "type": "object"
}
