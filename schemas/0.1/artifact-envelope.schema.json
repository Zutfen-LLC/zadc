{
  "$defs": {
    "PolicyReference": {
      "additionalProperties": false,
      "description": "Reference to the policy governing an artifact.\n\nFields (architecture section 10, ``policy``):\n- ``policy_id``: the policy identifier (e.g. ``zutfen:zadc-policy:standard@0.1.0``).\n- ``policy_source_sha``: the trusted commit SHA the policy was loaded from.\n- ``policy_digest``: the SHA-256 digest of the policy content.",
      "properties": {
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z][a-zA-Z0-9+.\\-]*:",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Policy Source Sha",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_source_sha",
        "policy_digest"
      ],
      "title": "PolicyReference",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Identity of the actor that produced an artifact.\n\nFields (architecture section 10, ``producer``):\n- ``actor_type``: human, agent, ci, validator, service.\n- ``actor_id``: URI-shaped global identifier for the actor.\n- ``run_id``: optional run/execution identifier.\n- ``model``: optional model identifier (for agent producers).\n- ``provider``: optional provider/service identifier.",
      "properties": {
        "actor_id": {
          "minLength": 1,
          "pattern": "^[a-zA-Z][a-zA-Z0-9+.\\-]*:",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "human",
            "agent",
            "ci",
            "validator",
            "service"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "run_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[a-zA-Z][a-zA-Z0-9+.\\-]*:",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Provenance chain for an artifact.\n\nFields (architecture section 10, ``provenance``):\n- ``parent_artifact_ids``: immutable tuple of parent artifact IDs.\n  Accepted as ``list`` or ``tuple`` at construction; internally immutable.\n- ``content_digest``: optional SHA-256 digest of the artifact content.\n  May be absent only before sealing.",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "parent_artifact_ids": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-zA-Z][a-zA-Z0-9+.\\-]*:",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://schemas.zutfen.com/zadc/0.1/artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Common artifact envelope for the Zutfen Agentic Development Contract v0.1. Every ZADC artifact MUST include this envelope.",
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9+.\\-]*:",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "enum": [
        "packet",
        "completion_report",
        "certification_manifest",
        "review_report",
        "decision_record",
        "workflow_bundle",
        "evidence_artifact",
        "observation"
      ],
      "title": "Artifact Type",
      "type": "string"
    },
    "contract_version": {
      "default": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/PolicyReference"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "project_id": {
      "minLength": 1,
      "pattern": "^[a-zA-Z][a-zA-Z0-9+.\\-]*:",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema": {
      "default": "https://schemas.zutfen.com/zadc/0.1/artifact.schema.json",
      "title": "Schema",
      "type": "string"
    },
    "slice_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Id",
      "type": "string"
    },
    "slice_instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Instance Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "project_id",
    "slice_id",
    "slice_instance_id",
    "policy",
    "provenance"
  ],
  "title": "ZADC Artifact Envelope",
  "type": "object"
}
