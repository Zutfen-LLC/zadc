{
  "$defs": {
    "PolicyReference": {
      "additionalProperties": false,
      "description": "Reference to the policy governing an artifact.\n\nFields (architecture section 10, ``policy``):\n- ``policy_id``: the policy identifier (e.g. ``zutfen:zadc-policy:standard@0.1.0``).\n- ``policy_source_sha``: the trusted commit SHA the policy was loaded from.\n- ``policy_digest``: the SHA-256 digest of the policy content.",
      "properties": {
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Policy Source Sha",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_source_sha",
        "policy_digest"
      ],
      "title": "PolicyReference",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Identity of the actor that produced an artifact.\n\nFields (architecture section 10, ``producer``):\n- ``actor_type``: human, agent, ci, validator, service.\n- ``actor_id``: URI-shaped global identifier for the actor.\n- ``run_id``: optional run/execution identifier.\n- ``model``: optional model identifier (for agent producers).\n- ``provider``: optional provider/service identifier.",
      "properties": {
        "actor_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "human",
            "agent",
            "ci",
            "validator",
            "service"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "run_id": {
          "anyOf": [
            {
              "allOf": [
                {
                  "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
                },
                {
                  "if": {
                    "pattern": "^urn:[uU][uU][iI][dD]:"
                  },
                  "then": {
                    "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              ],
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Provenance chain for an artifact.\n\nFields (architecture section 10, ``provenance``):\n- ``parent_artifact_ids``: REQUIRED immutable tuple of parent artifact IDs.\n  Accepted as ``list`` or ``tuple`` at construction; internally immutable.\n  Root artifacts must explicitly supply an empty array/tuple.\n- ``content_digest``: optional SHA-256 digest of the artifact content.\n  May be absent only before sealing.",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "parent_artifact_ids": {
          "items": {
            "allOf": [
              {
                "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
              },
              {
                "if": {
                  "pattern": "^urn:[uU][uU][iI][dD]:"
                },
                "then": {
                  "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            ],
            "minLength": 1,
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "parent_artifact_ids"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "$id": "https://schemas.zutfen.com/zadc/0.1/artifact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Common artifact envelope for the Zutfen Agentic Development Contract v0.1. Every ZADC artifact MUST include this envelope.",
  "properties": {
    "artifact_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "enum": [
        "packet",
        "completion_report",
        "certification_manifest",
        "review_report",
        "decision_record",
        "workflow_bundle",
        "evidence_artifact",
        "observation"
      ],
      "title": "Artifact Type",
      "type": "string"
    },
    "contract_version": {
      "const": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "not": {
        "pattern": "^.*-00:00$"
      },
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,6})?(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "title": "Created At",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/PolicyReference"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "project_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "schema": {
      "const": "https://schemas.zutfen.com/zadc/0.1/artifact.schema.json",
      "title": "Schema",
      "type": "string"
    },
    "slice_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Id",
      "type": "string"
    },
    "slice_instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Instance Id",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "contract_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "project_id",
    "slice_id",
    "slice_instance_id",
    "policy",
    "provenance"
  ],
  "title": "ZADC Artifact Envelope",
  "type": "object"
}
