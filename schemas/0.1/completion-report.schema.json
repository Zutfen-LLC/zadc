{
  "$defs": {
    "Changes": {
      "additionalProperties": false,
      "description": "The set of commits, changed files, and resolved dependency pins.",
      "properties": {
        "commits": {
          "items": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "title": "Commits",
          "type": "array"
        },
        "dependency_pins_resolved": {
          "items": {
            "$ref": "#/$defs/DependencyPinResolution"
          },
          "title": "Dependency Pins Resolved",
          "type": "array"
        },
        "files_changed": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Files Changed",
          "type": "array"
        }
      },
      "required": [
        "commits",
        "files_changed",
        "dependency_pins_resolved"
      ],
      "title": "Changes",
      "type": "object"
    },
    "DependencyPinResolution": {
      "additionalProperties": false,
      "description": "The observed resolution of one packet-declared dependency pin.",
      "properties": {
        "clean": {
          "title": "Clean",
          "type": "boolean"
        },
        "repository_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "sha",
        "clean"
      ],
      "title": "DependencyPinResolution",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "A pointer to an external evidence payload (architecture section 11.3).\n\nCarries the evidence identifier, its media type, the payload's own\nSHA-256 digest, and a trusted URI/provider location. This is a\nlightweight, denormalized reference distinct from a full\n:class:`~zadc.models.evidence_artifact.EvidenceArtifact` record — it\ndoes not carry availability, size, or a description.",
      "properties": {
        "artifact_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "location": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&\\-\\^_.+]*/[A-Za-z0-9][A-Za-z0-9!#$&\\-\\^_.+]*$",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "digest",
        "location"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "ExecutorClaim": {
      "additionalProperties": false,
      "description": "A material statement authored by an execution agent (architecture section 12).\n\nDefaults to ``AGENT_REPORTED`` epistemic status. Construction never\nautomatically promotes a claim to ``VERIFIED`` or any stronger status —\nupgrading epistemic status requires evidence or human judgment applied\nby a later validation slice, not this model.",
      "properties": {
        "epistemic_status": {
          "default": "AGENT_REPORTED",
          "enum": [
            "PROPOSED",
            "AGENT_REPORTED",
            "LOCALLY_OBSERVED",
            "CI_OBSERVED",
            "LIVE_SOURCE_OBSERVED",
            "INDEPENDENTLY_REPRODUCED",
            "VERIFIED",
            "CONTRADICTED",
            "STALE",
            "SUPERSEDED"
          ],
          "title": "Epistemic Status",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "evidence_refs"
      ],
      "title": "ExecutorClaim",
      "type": "object"
    },
    "PolicyReference": {
      "additionalProperties": false,
      "description": "Reference to the policy governing an artifact.\n\nFields (architecture section 10, ``policy``):\n- ``policy_id``: the policy identifier (e.g. ``zutfen:zadc-policy:standard@0.1.0``).\n- ``policy_source_sha``: the trusted commit SHA the policy was loaded from.\n- ``policy_digest``: the SHA-256 digest of the policy content.",
      "properties": {
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Policy Source Sha",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_source_sha",
        "policy_digest"
      ],
      "title": "PolicyReference",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Identity of the actor that produced an artifact.\n\nFields (architecture section 10, ``producer``):\n- ``actor_type``: human, agent, ci, validator, service.\n- ``actor_id``: URI-shaped global identifier for the actor.\n- ``run_id``: optional run/execution identifier.\n- ``model``: optional model identifier (for agent producers).\n- ``provider``: optional provider/service identifier.",
      "properties": {
        "actor_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "human",
            "agent",
            "ci",
            "validator",
            "service"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "run_id": {
          "anyOf": [
            {
              "allOf": [
                {
                  "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
                },
                {
                  "if": {
                    "pattern": "^urn:[uU][uU][iI][dD]:"
                  },
                  "then": {
                    "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              ],
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Provenance chain for an artifact.\n\nFields (architecture section 10, ``provenance``):\n- ``parent_artifact_ids``: REQUIRED immutable tuple of parent artifact IDs.\n  Accepted as ``list`` or ``tuple`` at construction; internally immutable.\n  Root artifacts must explicitly supply an empty array/tuple.\n- ``content_digest``: optional SHA-256 digest of the artifact content.\n  May be absent only before sealing.",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "parent_artifact_ids": {
          "items": {
            "allOf": [
              {
                "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
              },
              {
                "if": {
                  "pattern": "^urn:[uU][uU][iI][dD]:"
                },
                "then": {
                  "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            ],
            "minLength": 1,
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "parent_artifact_ids"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Reconciliation": {
      "additionalProperties": false,
      "description": "Enumerates intervening commits when the observed work-start SHA does\nnot match the packet's expected work-start SHA (architecture 13, INV-002).",
      "properties": {
        "intervening_commits": {
          "items": {
            "$ref": "#/$defs/ReconciliationCommit"
          },
          "title": "Intervening Commits",
          "type": "array"
        }
      },
      "required": [
        "intervening_commits"
      ],
      "title": "Reconciliation",
      "type": "object"
    },
    "ReconciliationCommit": {
      "additionalProperties": false,
      "description": "One intervening commit enumerated by a work-start reconciliation record.",
      "properties": {
        "disposition": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Disposition",
          "type": "string"
        },
        "rationale": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "sha",
        "disposition",
        "rationale"
      ],
      "title": "ReconciliationCommit",
      "type": "object"
    },
    "RepositoryState": {
      "additionalProperties": false,
      "description": "The observed repository state at completion-report time.",
      "properties": {
        "base_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Sha",
          "type": "string"
        },
        "branch": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._\\-/]*[A-Za-z0-9])?$",
          "title": "Branch",
          "type": "string"
        },
        "implementation_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Implementation Sha",
          "type": "string"
        },
        "pr_head_sha_observed": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pr Head Sha Observed"
        },
        "repository_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "base_sha",
        "implementation_sha",
        "branch"
      ],
      "title": "RepositoryState",
      "type": "object"
    },
    "VerificationClaims": {
      "additionalProperties": false,
      "description": "The executor-reported local verification commands and results.",
      "properties": {
        "commands_run": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Commands Run",
          "type": "array"
        },
        "local_results": {
          "items": {
            "$ref": "#/$defs/ExecutorClaim"
          },
          "title": "Local Results",
          "type": "array"
        }
      },
      "required": [
        "commands_run",
        "local_results"
      ],
      "title": "VerificationClaims",
      "type": "object"
    },
    "WorkStartObservation": {
      "additionalProperties": false,
      "description": "The observed work-start SHA versus the packet's expected SHA.",
      "properties": {
        "actual_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Actual Sha",
          "type": "string"
        },
        "expected_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Expected Sha",
          "type": "string"
        },
        "match": {
          "title": "Match",
          "type": "boolean"
        },
        "reconciliation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reconciliation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "expected_sha",
        "actual_sha",
        "match"
      ],
      "title": "WorkStartObservation",
      "type": "object"
    }
  },
  "$id": "https://schemas.zutfen.com/zadc/0.1/completion-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The execution agent's completion claim artifact for the Zutfen Agentic Development Contract v0.1 (architecture section 11.2). Records claims and local observations; it does not confer verified status.",
  "properties": {
    "artifact_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "completion_report",
      "title": "Artifact Type",
      "type": "string"
    },
    "changes": {
      "$ref": "#/$defs/Changes"
    },
    "contract_version": {
      "const": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "not": {
        "pattern": "^.*-00:00$"
      },
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "deviations": {
      "items": {
        "$ref": "#/$defs/ExecutorClaim"
      },
      "title": "Deviations",
      "type": "array"
    },
    "executor_recommendation": {
      "enum": [
        "green_for_review",
        "red",
        "blocked",
        "inconclusive"
      ],
      "title": "Executor Recommendation",
      "type": "string"
    },
    "known_limitations": {
      "items": {
        "$ref": "#/$defs/ExecutorClaim"
      },
      "title": "Known Limitations",
      "type": "array"
    },
    "open_issues": {
      "items": {
        "$ref": "#/$defs/ExecutorClaim"
      },
      "title": "Open Issues",
      "type": "array"
    },
    "packet_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Packet Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/PolicyReference"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "project_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "repository_state": {
      "$ref": "#/$defs/RepositoryState"
    },
    "run_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema": {
      "const": "https://schemas.zutfen.com/zadc/0.1/artifact.schema.json",
      "title": "Schema",
      "type": "string"
    },
    "slice_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Id",
      "type": "string"
    },
    "slice_instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Instance Id",
      "type": "string"
    },
    "verification_claims": {
      "$ref": "#/$defs/VerificationClaims"
    },
    "work_start": {
      "$ref": "#/$defs/WorkStartObservation"
    }
  },
  "required": [
    "schema",
    "contract_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "project_id",
    "slice_id",
    "slice_instance_id",
    "policy",
    "provenance",
    "packet_id",
    "run_id",
    "work_start",
    "repository_state",
    "changes",
    "verification_claims",
    "deviations",
    "known_limitations",
    "open_issues",
    "executor_recommendation"
  ],
  "title": "ZADC Completion Report",
  "type": "object"
}
