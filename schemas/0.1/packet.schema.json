{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "description": "A reference to another canonical ZADC artifact by ID and content digest.\n\nDistinct from :class:`EvidenceReference`, which points at an external,\nnon-ZADC evidence payload rather than another sealed ZADC artifact.",
      "properties": {
        "artifact_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "content_digest"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "DependencyPin": {
      "additionalProperties": false,
      "description": "A pinned cross-repository dependency (architecture 8.2, goal 7).",
      "properties": {
        "cleanliness_required": {
          "title": "Cleanliness Required",
          "type": "boolean"
        },
        "repository_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Sha",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "sha",
        "cleanliness_required"
      ],
      "title": "DependencyPin",
      "type": "object"
    },
    "PacketAuthorization": {
      "additionalProperties": false,
      "description": "The trusted human authorization binding for a packet (architecture 11.1).",
      "properties": {
        "authorized_at": {
          "format": "date-time",
          "not": {
            "pattern": "^.*-00:00$"
          },
          "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
          "title": "Authorized At",
          "type": "string"
        },
        "authorized_by": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Authorized By",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "not": {
                "pattern": "^.*-00:00$"
              },
              "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        }
      },
      "required": [
        "authorized_by",
        "authorized_at"
      ],
      "title": "PacketAuthorization",
      "type": "object"
    },
    "PacketIntent": {
      "additionalProperties": false,
      "description": "The authorized problem statement and desired outcome.",
      "properties": {
        "desired_outcome": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Desired Outcome",
          "type": "string"
        },
        "problem_statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Problem Statement",
          "type": "string"
        }
      },
      "required": [
        "problem_statement",
        "desired_outcome"
      ],
      "title": "PacketIntent",
      "type": "object"
    },
    "PacketReview": {
      "additionalProperties": false,
      "description": "The packet's independent-review requirement and blocking threshold.",
      "properties": {
        "independent_review_required": {
          "title": "Independent Review Required",
          "type": "boolean"
        },
        "minimum_severity_blocking": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "note"
          ],
          "title": "Minimum Severity Blocking",
          "type": "string"
        }
      },
      "required": [
        "independent_review_required",
        "minimum_severity_blocking"
      ],
      "title": "PacketReview",
      "type": "object"
    },
    "PacketScope": {
      "additionalProperties": false,
      "description": "The authorized and prohibited paths and operations for a packet.",
      "properties": {
        "allowed_operations": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Operations",
          "type": "array"
        },
        "allowed_paths": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Allowed Paths",
          "type": "array"
        },
        "prohibited_operations": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Prohibited Operations",
          "type": "array"
        },
        "prohibited_paths": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Prohibited Paths",
          "type": "array"
        }
      },
      "required": [
        "allowed_paths",
        "prohibited_paths",
        "allowed_operations",
        "prohibited_operations"
      ],
      "title": "PacketScope",
      "type": "object"
    },
    "PolicyReference": {
      "additionalProperties": false,
      "description": "Reference to the policy governing an artifact.\n\nFields (architecture section 10, ``policy``):\n- ``policy_id``: the policy identifier (e.g. ``zutfen:zadc-policy:standard@0.1.0``).\n- ``policy_source_sha``: the trusted commit SHA the policy was loaded from.\n- ``policy_digest``: the SHA-256 digest of the policy content.",
      "properties": {
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "policy_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "policy_source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Policy Source Sha",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "policy_source_sha",
        "policy_digest"
      ],
      "title": "PolicyReference",
      "type": "object"
    },
    "ProducerIdentity": {
      "additionalProperties": false,
      "description": "Identity of the actor that produced an artifact.\n\nFields (architecture section 10, ``producer``):\n- ``actor_type``: human, agent, ci, validator, service.\n- ``actor_id``: URI-shaped global identifier for the actor.\n- ``run_id``: optional run/execution identifier.\n- ``model``: optional model identifier (for agent producers).\n- ``provider``: optional provider/service identifier.",
      "properties": {
        "actor_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Actor Id",
          "type": "string"
        },
        "actor_type": {
          "enum": [
            "human",
            "agent",
            "ci",
            "validator",
            "service"
          ],
          "title": "Actor Type",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "run_id": {
          "anyOf": [
            {
              "allOf": [
                {
                  "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
                },
                {
                  "if": {
                    "pattern": "^urn:[uU][uU][iI][dD]:"
                  },
                  "then": {
                    "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  }
                }
              ],
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        }
      },
      "required": [
        "actor_type",
        "actor_id"
      ],
      "title": "ProducerIdentity",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Provenance chain for an artifact.\n\nFields (architecture section 10, ``provenance``):\n- ``parent_artifact_ids``: REQUIRED immutable tuple of parent artifact IDs.\n  Accepted as ``list`` or ``tuple`` at construction; internally immutable.\n  Root artifacts must explicitly supply an empty array/tuple.\n- ``content_digest``: optional SHA-256 digest of the artifact content.\n  May be absent only before sealing.",
      "properties": {
        "content_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Digest"
        },
        "parent_artifact_ids": {
          "items": {
            "allOf": [
              {
                "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
              },
              {
                "if": {
                  "pattern": "^urn:[uU][uU][iI][dD]:"
                },
                "then": {
                  "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            ],
            "minLength": 1,
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        }
      },
      "required": [
        "parent_artifact_ids"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RepositoryTarget": {
      "additionalProperties": false,
      "description": "The repository identity and optional pull-request target of a packet.",
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]*$",
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._\\-]*$",
          "title": "Owner",
          "type": "string"
        },
        "provider": {
          "const": "github",
          "title": "Provider",
          "type": "string"
        },
        "pull_request": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pull Request"
        },
        "repository_id": {
          "allOf": [
            {
              "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
            },
            {
              "if": {
                "pattern": "^urn:[uU][uU][iI][dD]:"
              },
              "then": {
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          ],
          "minLength": 1,
          "title": "Repository Id",
          "type": "string"
        }
      },
      "required": [
        "repository_id",
        "provider",
        "owner",
        "name"
      ],
      "title": "RepositoryTarget",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "description": "One normative requirement with its acceptance criteria.",
      "properties": {
        "acceptance_criteria": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "requirement_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._\\-]*[A-Za-z0-9])?$",
          "title": "Requirement Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "statement",
        "acceptance_criteria"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "VerificationRequirements": {
      "additionalProperties": false,
      "description": "The mandatory/advisory verification lanes and exact-subject policy.",
      "properties": {
        "advisory_lanes": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._\\-]*[A-Za-z0-9])?$",
            "type": "string"
          },
          "title": "Advisory Lanes",
          "type": "array"
        },
        "exact_subject_policy": {
          "enum": [
            "final_pr_head",
            "certified_code_with_evidence_tail"
          ],
          "title": "Exact Subject Policy",
          "type": "string"
        },
        "mandatory_lanes": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._\\-]*[A-Za-z0-9])?$",
            "type": "string"
          },
          "title": "Mandatory Lanes",
          "type": "array"
        },
        "synthetic_merge_required": {
          "title": "Synthetic Merge Required",
          "type": "boolean"
        }
      },
      "required": [
        "mandatory_lanes",
        "advisory_lanes",
        "exact_subject_policy",
        "synthetic_merge_required"
      ],
      "title": "VerificationRequirements",
      "type": "object"
    },
    "WorkStartAuthorization": {
      "additionalProperties": false,
      "description": "The authorized work-start commit and mismatch policy (architecture 13).",
      "properties": {
        "expected_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Expected Sha",
          "type": "string"
        },
        "mismatch_policy": {
          "enum": [
            "abort",
            "reconcile_with_record"
          ],
          "title": "Mismatch Policy",
          "type": "string"
        }
      },
      "required": [
        "expected_sha",
        "mismatch_policy"
      ],
      "title": "WorkStartAuthorization",
      "type": "object"
    }
  },
  "$id": "https://schemas.zutfen.com/zadc/0.1/packet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The authoritative, human-approved work authorization artifact for the Zutfen Agentic Development Contract v0.1 (architecture section 11.1). Packet immutability in this slice is structural only; trusted-human authorization binding is deferred.",
  "properties": {
    "artifact_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "packet",
      "title": "Artifact Type",
      "type": "string"
    },
    "authorization": {
      "$ref": "#/$defs/PacketAuthorization"
    },
    "completion_report_requirements": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Completion Report Requirements",
      "type": "array"
    },
    "contract_version": {
      "const": "0.1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "not": {
        "pattern": "^.*-00:00$"
      },
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$",
      "title": "Created At",
      "type": "string"
    },
    "deliverables": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Deliverables",
      "type": "array"
    },
    "dependency_pins": {
      "items": {
        "$ref": "#/$defs/DependencyPin"
      },
      "title": "Dependency Pins",
      "type": "array"
    },
    "intent": {
      "$ref": "#/$defs/PacketIntent"
    },
    "policy": {
      "$ref": "#/$defs/PolicyReference"
    },
    "producer": {
      "$ref": "#/$defs/ProducerIdentity"
    },
    "project_id": {
      "allOf": [
        {
          "pattern": "^[a-z][a-z0-9+.\\-]*:(?:[A-Za-z0-9\\-._~:/?#\\[\\]@!$&'()*+,;=]|%[0-9A-F]{2})+$"
        },
        {
          "if": {
            "pattern": "^urn:[uU][uU][iI][dD]:"
          },
          "then": {
            "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      ],
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "repository": {
      "$ref": "#/$defs/RepositoryTarget"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "review": {
      "$ref": "#/$defs/PacketReview"
    },
    "schema": {
      "const": "https://schemas.zutfen.com/zadc/0.1/artifact.schema.json",
      "title": "Schema",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/PacketScope"
    },
    "slice_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Id",
      "type": "string"
    },
    "slice_instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Z0-9]([A-Z0-9\\-]*[A-Z0-9])?$",
      "title": "Slice Instance Id",
      "type": "string"
    },
    "stop_conditions": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Stop Conditions",
      "type": "array"
    },
    "supersedes": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification": {
      "$ref": "#/$defs/VerificationRequirements"
    },
    "work_start": {
      "$ref": "#/$defs/WorkStartAuthorization"
    }
  },
  "required": [
    "schema",
    "contract_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "project_id",
    "slice_id",
    "slice_instance_id",
    "policy",
    "provenance",
    "authorization",
    "repository",
    "work_start",
    "intent",
    "scope",
    "requirements",
    "dependency_pins",
    "verification",
    "review",
    "stop_conditions",
    "deliverables",
    "completion_report_requirements"
  ],
  "title": "ZADC Packet",
  "type": "object"
}
