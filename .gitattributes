# Auto-detect text files and perform LF normalization
* text=auto eol=lf

# Ensure these are always treated as text with LF
*.py     text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.cfg    text eol=lf
*.txt    text eol=lf
*.lock   text diff=lockb

# Ensure these are treated as binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.pdf    binary
